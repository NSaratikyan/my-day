{
  "name": "im-ory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "esbuild": "$esbuild"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "build:pages": "tsc -b && vite build --configLoader runner --mode github-pages && node scripts/check-pages.mjs",
    "preview:pages": "vite preview --host 0.0.0.0 --configLoader runner --mode github-pages --port 4180",
    "preview": "vite preview --host 0.0.0.0 --configLoader runner",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.6.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^3.25.49"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "esbuild": "npm:esbuild-wasm@^0.25.12",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0"
  }
}
